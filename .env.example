# Environment Configuration
NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:3000
API_URL=http://localhost:4000/api

# Database Connection
# Standard PostgreSQL URL or SQLite for quick local demo:
DATABASE_URL="file:./dev.db"

# Security & JWT
JWT_SECRET=tourlatam_2026_super_secret_jwt_key_pmi_bolivia_chapter_prod_2026
JWT_EXPIRES_IN=7d
